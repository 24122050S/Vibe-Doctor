{
  "name": "vibe-doctor",
  "version": "1.4.1",
  "description": "AI Codebase Governance & Architecture Guardrail CLI — Two-tier AST + LLM auditor with Auto Fix-Prompt Generation",
  "type": "module",
  "bin": {
    "vibe-doctor": "./bin/vibe-doctor.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "bin",
    "dist",
    "templates",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start": "node bin/vibe-doctor.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": [
    "architecture",
    "guardrail",
    "ast",
    "vibe-coding",
    "llm",
    "code-governance",
    "clean-architecture",
    "pre-commit",
    "cli"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/24122050S/Vibe-Doctor.git"
  },
  "homepage": "https://github.com/24122050S/Vibe-Doctor#readme",
  "bugs": {
    "url": "https://github.com/24122050S/Vibe-Doctor/issues"
  },
  "dependencies": {
    "@google/genai": "^1.0.0",
    "chalk": "^5.4.1",
    "commander": "^13.1.0",
    "ora": "^8.2.0",
    "picomatch": "^4.0.2",
    "ts-morph": "^25.0.1",
    "yaml": "^2.7.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "@types/picomatch": "^4.0.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.7"
  },
  "license": "MIT"
}
