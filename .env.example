# ============================================================================
# 🩺 Vibe Doctor — Cấu hình Biến môi trường cho Tầng 2 (LLM Alignment)
# Cách dùng: Sao chép file này thành `.env` (hoặc `.env.local`) và điền API Key
#   Copy-Item .env.example .env
# ============================================================================

# 1. Google Gemini API (Khuyên dùng mặc định cho gemini-2.5-flash)
# Lấy key miễn phí tại: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# 2. Ollama Local (Tuỳ chọn nếu đặt `provider: "ollama"` trong .archrules.yaml)
# Mặc định không cần key, kết nối tới http://localhost:11434
OLLAMA_HOST=http://localhost:11434

# 3. OpenAI / OpenAI-Compatible API (Tuỳ chọn nếu đặt `provider: "openai"`)
OPENAI_API_KEY=
